#!/bin/sh
# Enforces Conventional Commits on the first line of the commit message.
# Merge/Revert commits are passed through unchecked.

first_line=$(head -n 1 "$1")

case "$first_line" in
    "Merge "*|"Revert "*)
        exit 0
        ;;
esac

if echo "$first_line" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'; then
    exit 0
fi

echo "Commit message does not follow Conventional Commits:"
echo ""
echo "  $first_line"
echo ""
echo "Expected format: <type>(<optional scope>)!: <description>"
echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
echo ""
echo "Examples:"
echo "  feat: add self-timer chime"
echo "  fix(timers): correct offset rounding"
echo ""
echo "See https://www.conventionalcommits.org/ for details."
exit 1
